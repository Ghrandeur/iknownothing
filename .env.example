NODE_ENV=development
HOST=0.0.0.0
PORT=8080
APP_URL=http://localhost:8080
DATABASE_FILE=data/nlqi.sqlite
UPLOAD_DIR=uploads
SESSION_TTL_DAYS=7
APPLICATION_FEE=5000

# Vercel production persistence
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nlqi-applicant-documents

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=NLQI Administrator

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

# Gmail SMTP (use a Google App Password; never use your regular account password)
EMAIL_SERVICE=gmail
EMAIL_FROM=NLQI
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_AUTH_METHOD=PLAIN

# Optional SMTP_* compatibility settings; EMAIL_* variables take precedence.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=info@nlqi.ng
