{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/apply/?$",
      "dest": "/public/apply.html"
    },
    {
      "src": "/register/?$",
      "dest": "/public/register.html"
    },
    {
      "src": "/login/?$",
      "dest": "/public/login.html"
    },
    {
      "src": "/verify/?$",
      "dest": "/public/verify.html"
    },
    {
      "src": "/track/?$",
      "dest": "/public/track.html"
    },
    {
      "src": "/admin/?$",
      "dest": "/public/admin.html"
    },
    {
      "src": "/judge/?$",
      "dest": "/public/judge.html"
    },
    {
      "src": "/forgot-password/?$",
      "dest": "/public/forgot-password.html"
    },
    {
      "src": "/reset-password/?$",
      "dest": "/public/reset-password.html"
    },
    {
      "src": "/contact/?$",
      "dest": "/public/contact.html"
    },
    {
      "src": "/privacy/?$",
      "dest": "/public/privacy.html"
    },
    {
      "src": "/blog/?$",
      "dest": "/public/blog.html"
    },
    {
      "src": "/blog-post/?$",
      "dest": "/public/blog-post.html"
    },
    {
      "src": "/gallery/?$",
      "dest": "/public/gallery.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
